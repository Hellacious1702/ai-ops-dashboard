# AI Ops Dashboard - Environment Configuration
# Copy this file to .env and customize values

# Application
APP_NAME=AI Ops Dashboard
ENVIRONMENT=development
LOG_LEVEL=INFO
DATA_DIR=data

# Database
DB_SQLITE_PATH=data/ai_ops.db
DB_PARQUET_EXPORT_PATH=data/parquet
DB_EXPORT_INTERVAL_SECONDS=300
DB_CONNECTION_POOL_SIZE=5

# Instrumentation
INSTR_ENABLED=true
INSTR_SAMPLE_RATE=1.0
INSTR_CAPTURE_PROMPT=false
INSTR_CAPTURE_RESPONSE=false
INSTR_MAX_PROMPT_LENGTH=10000
INSTR_MAX_RESPONSE_LENGTH=10000
INSTR_ASYNC_BUFFER_SIZE=100
INSTR_FLUSH_INTERVAL_SECONDS=5.0

# Metrics
METRICS_ENABLED=true
METRICS_AGGREGATION_WINDOW_SECONDS=60
METRICS_RETENTION_DAYS=30
METRICS_PERCENTILE_BUCKETS=0.5,0.95,0.99

# Recommendations
REC_ENABLED=true
REC_CHECK_INTERVAL_SECONDS=3600
REC_ROUTING_ENABLED=true
REC_ROUTING_COST_THRESHOLD=0.10
REC_ROUTING_LATENCY_THRESHOLD_MS=5000
REC_CACHING_ENABLED=true
REC_CACHING_MIN_CALLS=10
REC_CACHING_SIMILARITY_THRESHOLD=0.95
REC_COMPRESSION_ENABLED=true
REC_COMPRESSION_MIN_TOKENS=1000
REC_COMPRESSION_TARGET_REDUCTION=0.3
REC_BATCHING_ENABLED=true
REC_BATCHING_MIN_CALLS=5
REC_BATCHING_WINDOW_SECONDS=60

# Alerting
ALERT_ENABLED=true
ALERT_COST_DAILY_THRESHOLD=100.0
ALERT_COST_HOURLY_THRESHOLD=20.0
ALERT_LATENCY_P99_THRESHOLD_MS=10000
ALERT_ERROR_RATE_THRESHOLD=0.05
ALERT_COOLDOWN_SECONDS=300

# Web UI
WEB_HOST=0.0.0.0
WEB_PORT=8000
WEB_RELOAD=false
WEB_CORS_ORIGINS=*
WEB_WS_PING_INTERVAL=30

# TUI
TUI_REFRESH_RATE=2.0
TUI_THEME=dark
TUI_SHOW_CHARTS=true